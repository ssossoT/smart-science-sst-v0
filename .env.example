# Vercel → Settings → Environment Variables 에 등록할 값들
# 이 파일은 형식 안내용입니다. 실제 값을 여기에 적지 마세요.

# 초안 만들기 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# 영상 검색 (Cloud Console에서 YouTube Data API v3 사용 설정 후 발급)
YOUTUBE_API_KEY=

# Firebase 서비스 계정 (Firebase Console → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 생성)
# 내려받은 JSON 파일의 project_id / client_email / private_key 값을 넣습니다.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=

# private_key 는 JSON 안의 큰따옴표 안쪽 내용을 그대로 복사해 넣으면 됩니다.
# \n 이 글자 그대로 들어가도 서버가 알아서 줄바꿈으로 바꿉니다.
# 예: -----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBg...\n-----END PRIVATE KEY-----\n
FIREBASE_ADMIN_PRIVATE_KEY=

# 선택 - 다른 Gemini 모델을 쓰고 싶을 때만 (기본값 gemini-2.5-flash)
# GEMINI_MODEL=
